# Git tracks source and build files only: C++ (*.cpp, *.h), Python (*.py), the
# Makefiles and physics/host.mk, the toolchain definition physics/Makefile includes.
# Everything else is ignored by default -- documents (.md/.tex are kept in step
# between the machines by research_backup/sync.py), notebooks (FreeFileSync),
# data, figures, legacy/ and tool state. To start tracking a new kind of file,
# add a `!` line to the whitelist below.

*
!*/
!.gitignore
!.gitattributes
!*.cpp
!*.h
!*.py
!Makefile*
!/physics/host.mk

# Never tracked, even when a file inside matches the whitelist.
CLAUDE.md
/legacy/
build/
__pycache__/
.ipynb_checkpoints/
.claude/
.vscode/

# Run roots: <repo>/<model>/ is where generator_<model>.py works, and run
# scratch the submitter creates.
/two_band/
/four_band/
dir_[0-9][0-9][0-9][0-9][0-9]/
incomplete_runs/
array_logs/
