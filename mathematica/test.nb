        RowBox[{"{", 
         RowBox[{"px", ",", 
          RowBox[{"-", "0.5"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"py", ",", 
          RowBox[{"-", "1.0"}]}], "}"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"saddle2", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"px", ",", "py"}], "}"}], "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"dEx", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "==", "0"}], ",", 
