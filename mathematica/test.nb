Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<NumericalCalculus`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dEx", "[", 
   RowBox[{
    RowBox[{"px_", "?", "NumericQ"}], ",", 
    RowBox[{"py_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"ND", "[", 
   RowBox[{
    RowBox[{"band3", "[", 
     RowBox[{"x", ",", "py"}], "]"}], ",", "x", ",", "px"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dEy", "[", 
    RowBox[{
     RowBox[{"px_", "?", "NumericQ"}], ",", 
     RowBox[{"py_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"ND", "[", 
    RowBox[{
     RowBox[{"band3", "[", 
      RowBox[{"px", ",", "y"}], "]"}], ",", "y", ",", "py"}], "]"}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "small", " ", "initial", " ", "guesses", " ", "near", " ", 
    "the", " ", "origin", " ", 
    RowBox[{"(", 
     RowBox[{"approx", " ", "0.04"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centralMin", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"px", ",", "py"}], "}"}], "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"dEx", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"dEy", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"px", ",", "0.0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"py", ",", "0.0"}], "}"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"saddle1", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"px", ",", "py"}], "}"}], "/.", " ", 
    RowBox[{"FindRoot", "[", 
