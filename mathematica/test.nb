      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"dEx", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"dEy", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "==", "0"}]}], "}"}], ",", 
