Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Use", " ", "the", " ", "parameters", " ", "above"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"gamma1", "=", "0.4"}], ";", 
    RowBox[{"v", "=", "1.0"}], ";", 
    RowBox[{"v3", "=", "0.1"}], ";", 
    RowBox[{"V", "=", "0.04"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Hamiltonian", " ", "and", " ", "Eigenvalues"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H0", "[", 
      RowBox[{"px_", ",", "py_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"V", "/", "2"}], ",", 
         RowBox[{"v", " ", 
          RowBox[{"(", 
           RowBox[{"px", "-", 
            RowBox[{"I", " ", "py"}]}], ")"}]}], ",", "0", ",", 
         RowBox[{"v3", " ", 
          RowBox[{"(", 
           RowBox[{"px", "+", 
            RowBox[{"I", " ", "py"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", " ", 
          RowBox[{"(", 
           RowBox[{"px", "+", 
            RowBox[{"I", " ", "py"}]}], ")"}]}], ",", 
         RowBox[{"V", "/", "2"}], ",", "gamma1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "gamma1", ",", 
         RowBox[{
          RowBox[{"-", "V"}], "/", "2"}], ",", 
         RowBox[{"v", " ", 
          RowBox[{"(", 
           RowBox[{"px", "-", 
            RowBox[{"I", " ", "py"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v3", " ", 
          RowBox[{"(", 
           RowBox[{"px", "-", 
            RowBox[{"I", " ", "py"}]}], ")"}]}], ",", "0", ",", 
         RowBox[{"v", " ", 
          RowBox[{"(", 
           RowBox[{"px", "+", 
            RowBox[{"I", " ", "py"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"-", "V"}], "/", "2"}]}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Evec", "[", 
      RowBox[{
       RowBox[{"px_", "?", "NumericQ"}], ",", 
       RowBox[{"py_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Sort", "[", 
      RowBox[{"Re", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"N", "[", 
         RowBox[{"H0", "[", 
          RowBox[{"px", ",", "py"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"band3", "[", 
      RowBox[{
       RowBox[{"px_", "?", "NumericQ"}], ",", 
       RowBox[{"py_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Evec", "[", 
       RowBox[{"px", ",", "py"}], "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "plot", " ", "shows", " ", "the", " ", "LT", " ", "exactly", 
     " ", "like", " ", "the", " ", "paper"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"band3", "[", 
      RowBox[{"px", ",", "py"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"px", ",", 
       RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"py", ",", 
       RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], ",", 
     RowBox[{"Contours", "->", 
      RowBox[{"{", 
       RowBox[{"0.019", ",", "0.02", ",", "0.021"}], "}"}]}], ",", 
     RowBox[{"ContourShading", "->", "None"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Red", ",", "Green"}], "}"}]}], ",", 
